{
  "name": "my-portfolio",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "fetch:newsletters": "node scripts/fetch-newsletters.mjs",
    "fetch:papers": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/fetch-papers.mjs",
    "fetch:content": "npm run fetch:newsletters && npm run fetch:papers",
    "predev": "npm run fetch:content",
    "dev": "next dev --webpack",
    "dev:turbopack": "next dev --turbopack",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint .",
    "prebuild": "npm run fetch:content"
  },
  "dependencies": {
    "@iconify/react": "^6.0.4",
    "classnames": "^2.5.1",
    "framer-motion": "^12.43.0",
    "lucide-react": "^1.74.0",
    "next": "^16.4.6",
    "next-themes": "^0.4.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.5",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/webpack": "^5.28.5",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.6",
    "fast-xml-parser": "^5.12.1",
    "postcss": "^8.5.33",
    "tailwindcss": "^4.3.5",
    "typescript": "^6.0.3"
  }
}
